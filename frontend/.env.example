# MultiWork Frontend Environment Variables
# In local development with Vite dev server, empty string uses the Vite proxy (/api)
# For production or direct backend connections, set the full URL:
VITE_API_BASE_URL=

# Leaflet & OpenStreetMap Tile Configuration
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Reverse Geocoding API Configuration (OpenStreetMap Nominatim default)
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/reverse

# Default Map Center (Coimbatore, Tamil Nadu)
VITE_COIMBATORE_DEFAULT_LAT=11.0168
VITE_COIMBATORE_DEFAULT_LNG=76.9558
