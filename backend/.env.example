# Home 2 Service — Backend Environment Variables Template
# Set DEBUG=False for production deployment (Render)
DEBUG=False
SECRET_KEY=generate-a-secure-random-secret-key-for-production
ALLOWED_HOSTS=home2service-backend.onrender.com,localhost,127.0.0.1

# Neon PostgreSQL Database Connection (Production)
# Example: postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Fallback local PostgreSQL (Used only when DATABASE_URL is empty)
DB_NAME=multiwork_db
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Origins (Vercel Frontend URL)
# Example: https://home2service.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://home2service.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://home2service.vercel.app

# Optional Performance / Security settings
DB_CONN_MAX_AGE=600
SECURE_SSL_REDIRECT=True
